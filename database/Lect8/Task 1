--Task 1 
--in hr schema there exist 
--- LOCATIONS Table and COUNTRIES Table
--Please apply 
--- natural join
--- join with  using keyword with column COUNTRY_ID
--- join with  on keyword with column COUNTRY_ID
--- inner join with 
--- left join with 
--- right join with 
--- fulljoin with 


--natural join
SELECT 
        location_id,
       street_address,
       postal_code,
       city,
       state_province,
       country_id,
       country_name
FROM locations
        NATURAL JOIN countries
;

--join with  using keyword with column COUNTRY_ID
SELECT location_id,
       street_address,
       postal_code,
       city,
       state_province,
       country_id,
       country_name
FROM locations
JOIN countries
    USING (country_id)
;

--join with  on keyword with column COUNTRY_ID
SELECT l.location_id,
       l.street_address,
       l.postal_code,
       l.city,
       l.state_province,
       l.country_id,
       c.country_name
FROM locations l
    JOIN countries c
        ON l.country_id = c.country_id
;

--inner join
SELECT l.location_id,
       l.street_address,
       l.postal_code,
       l.city,
       l.state_province,
       l.country_id,
       c.country_name
FROM locations l
INNER JOIN countries c
ON l.country_id = c.country_id;



--LEFT JOIN
SELECT l.location_id,
       l.street_address,
       l.postal_code,
       l.city,
       l.state_province,
       l.country_id,
       c.country_name
FROM locations l
LEFT JOIN countries c
ON l.country_id = c.country_id;


--right join
SELECT l.location_id,
       l.street_address,
       l.postal_code,
       l.city,
       l.state_province,
       l.country_id,
       c.country_name
FROM locations l
RIGHT JOIN countries c
ON l.country_id = c.country_id;


--fulljoin
SELECT l.location_id,
       l.street_address,
       l.postal_code,
       l.city,
       l.state_province,
       l.country_id,
       c.country_name
FROM locations l
FULL OUTER JOIN countries c
ON l.country_id = c.country_id;
