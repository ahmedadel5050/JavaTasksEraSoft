--create table Manger contain
create table Manger (
id          NUMBER(12), 
name        VARCHAR2(120), 
age         NUMBER(2), 
birth_date  DATE, 
address     VARCHAR2(200)
);
--=================================================

--alter table manger drop address column
ALTER TABLE MANGER
drop (address) ;
--=================================================

--alter table manger add column (city_address, street) 
ALTER TABLE MANGER 
ADD ( city_address VARCHAR2(200) ,
    street VARCHAR2(200) 
    );
--=================================================
--modify column name to full_name
ALTER TABLE MANGER 
RENAME COLUMN  name TO full_name 
;
--=================================================
--make this table just for read
ALTER TABLE MANGER  READ ONLY ;

--=================================================
--create table same as  Manger with name Owner
--just has colum id, name, birth_date 

CREATE TABLE HR.SAME
AS
SELECT id , full_name, birth_date FROM Manger
;
--=================================================

--rename manger table name to Master
 RENAME  Manger TO Master;
--=================================================
--drop all tables     
DROP TABLE Manger ;
DROP TABLE  SAME ;
